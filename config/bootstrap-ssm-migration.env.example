# Local configuration for scripts/bootstrap-ssm-migration.sh
#
# Copy this file to:
#   config/bootstrap-ssm-migration.env
#
# The populated file is gitignored. Keep permissions restrictive, for example:
#   chmod 600 config/bootstrap-ssm-migration.env
#
# This is a shell environment file. Quote values that contain special characters.

# Repository / GitHub Actions environment
REPO="antonio1000homens/recordings"
GH_ENVIRONMENT="production"

# AWS deployment configuration
AWS_REGION="eu-west-2"
DEPLOYMENT_ROLE_NAME="GitHubActionsRecordingsDeployRole"
SSM_PREFIX="/recordings/prod"
CODE_BUCKET=""

# Optional authentication overrides.
# Leave these commented when `aws`, `gh`, and `bws` are already authenticated.
# Prefer an AWS profile over static AWS access keys.
# AWS_PROFILE="my-development-profile"
# GH_TOKEN="ghp_..."
# BWS_ACCESS_TOKEN="..."

# Optional Bitwarden secret-ID overrides.
# Normally the bootstrap discovers records by logical key. Uncomment an entry only
# when the Bitwarden key differs or multiple records match. Values here are record
# UUIDs, not the secret values themselves.
# BW_RECORDINGS_SHARED_SECRET="00000000-0000-0000-0000-000000000000"
# BW_GEMINI_API_KEY="00000000-0000-0000-0000-000000000000"
# BW_RECORDINGS_DELIVERY_WEBHOOK="00000000-0000-0000-0000-000000000000"
# BW_RECORDINGS_SLACK_WEBHOOK="00000000-0000-0000-0000-000000000000"
# BW_CF_DEPLOY_API_TOKEN="00000000-0000-0000-0000-000000000000"
# BW_RECORDINGS_WORKER_AWS_ACCESS_KEY_ID="00000000-0000-0000-0000-000000000000"
# BW_RECORDINGS_WORKER_AWS_SECRET_ACCESS_KEY="00000000-0000-0000-0000-000000000000"
